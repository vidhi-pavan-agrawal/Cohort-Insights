# Copy to .env and adjust. Every variable has a sane default (see app/core/config.py).

# --- Application -------------------------------------------------------------
APP_NAME=cohort-insights-api
ENVIRONMENT=local                 # local | test | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                     # true = JSON logs (prod), false = pretty console logs (dev)

# --- Host port mapping used by docker-compose ----------------------------------
API_PORT=8000
MONGO_PORT=27017
REDIS_PORT=6379

# --- MongoDB -----------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017   # overridden to mongodb://mongo:27017 inside compose
MONGO_DB=cohort_insights
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0    # overridden to redis://redis:6379/0 inside compose
REDIS_SOCKET_TIMEOUT_SECONDS=0.5      # short: a slow/dead Redis must not stall requests (we degrade instead)

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_MAX_ACTIVE=3               # max docs per user in {queued, processing, enriching}
RATE_LIMIT_KEY_TTL_SECONDS=86400      # safety-net TTL on the per-user active-set hash

# --- Content cache -----------------------------------------------------------
CACHE_TTL_SECONDS=604800              # 7 days; results are deterministic per content hash

# --- Pipeline simulation -----------------------------------------------------
PIPELINE_ENABLED=true
PIPELINE_WORKER_CONCURRENCY=4         # in-process asyncio workers per API replica
PROCESSING_MIN_SECONDS=10
PROCESSING_MAX_SECONDS=20
ENRICHING_MIN_SECONDS=5
ENRICHING_MAX_SECONDS=15
STAGE_FAILURE_RATE=0.1                # independent per stage attempt
STAGE_MAX_ATTEMPTS=3                  # attempts per stage (1 = no automatic retry)
RETRY_BACKOFF_BASE_SECONDS=1.0        # exponential: base * 2^(attempt-1), capped
RETRY_BACKOFF_MAX_SECONDS=8.0
LEASE_SECONDS=60                      # a worker's claim on a job; renewed on every stage attempt
RECOVERY_INTERVAL_SECONDS=15          # orphaned-job sweeper + rate-limit reconciliation period
